# ============================================================
#  Botuň sazlamalary. Bu faýly ".env" diýip göçürip dolduryň.
# ============================================================

# 1) @BotFather-den alan tokeniňiz
TELEGRAM_BOT_TOKEN=123456789:AAAA-sizin-tokeniniz

# 2) Boty ulanyp biljek adamlaryň Telegram ID-leri (otur bilen bölüp).
#    Öz ID-ňizi bilmek üçin bota /id ýazyň.
ALLOWED_USERS=123456789

# 3) Google Drive-da wideolar haýsy papka goýulsyn
DRIVE_FOLDER_NAME=YouTube Bot

# 4) true  = ssylkasy bolan islendik adam wideony görüp biler
#    false = diňe siz (Google akkauntyňyz bilen) görüp bilersiňiz
MAKE_PUBLIC=true

# 5) Iň ýokary hil (360, 480, 720, 1080, 1440, 2160)
MAX_HEIGHT=1080

# 6) (Hökman däl) YouTube "bot däldigiňizi tassyklaň" diýse, cookies.txt goýuň
COOKIES_FILE=cookies.txt
